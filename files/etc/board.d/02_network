#!/bin/sh
# ROCEOS K50S Network Interface Specification (Aligned with iStoreOS 24.12 & Board Manual)
# LAN (3x 2.5G Electric Ports): eth0, eth1, eth2
# WAN (2x SFP Optical Ports): eth3 (Upper SFP), eth4 (Lower SFP)

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update
board=$(board_name)

case "$board" in
*)
	ucidef_set_interfaces_lan_wan 'eth0 eth1 eth2' 'eth3 eth4'
	;;
esac

board_config_flush

exit 0
